# Deployment used by `npx convex dev`
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
# NEXT_PUBLIC_CONVEX_SITE_URL=

# Canonical site URL for JSON-LD / SEO
# NEXT_PUBLIC_SITE_URL=https://zerobug.ro

# --- Secrets (REPLACE_ME — never deploy literal placeholders) ---
# Set the same values on Vercel AND Convex Dashboard where noted.

# Weekly sitemap cron (Vercel Cron Authorization: Bearer …) — also on Convex
CRON_SECRET=REPLACE_ME_CRON_SECRET_MIN_24_CHARS

ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD_MIN_12_CHARS
ADMIN_SESSION_SECRET=REPLACE_ME_ADMIN_SESSION_SECRET_MIN_24_CHARS
# Optional: bump to invalidate all admin JWTs (unix seconds). Set on Vercel + Convex.
# ADMIN_SESSION_MIN_IAT=0

# Stripe (required for checkout + webhooks — set on Vercel; webhook secret also useful on Convex if mirrored)
STRIPE_SECRET_KEY=sk_live_...or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Distinct from webhook signing secret — Next.js → Convex billing bridge (also on Convex)
CONVEX_BRIDGE_SECRET=REPLACE_ME_CONVEX_BRIDGE_SECRET_MIN_24_CHARS

# Lead forms use short-lived JWTs from /api/leads/challenge (signed with ADMIN_SESSION_SECRET)
# No extra CAPTCHA keys required; honeypot field `website` must stay empty.

# Resend (invoice emails + lead notifications)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=ZeroBug <contact@zerobug.ro>
LEADS_INBOX_EMAIL=contact@zerobug.ro

# Google Ads — OAuth (Cloud Console Web client) + Data Manager conversion upload
# Also set GOOGLE_OAUTH_CLIENT_ID + GOOGLE_OAUTH_CLIENT_SECRET in Convex Dashboard env
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/admin/google-ads/callback
# Production: https://zerobug.ro/api/admin/google-ads/callback
# Also set in Convex Dashboard (for upload + listing campaigns/conversions):
# GOOGLE_OAUTH_CLIENT_ID, GOOGLE_OAUTH_CLIENT_SECRET, GOOGLE_ADS_DEVELOPER_TOKEN
GOOGLE_ADS_DEVELOPER_TOKEN=
