# Deployment used by `npx convex dev`
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
# NEXT_PUBLIC_CONVEX_SITE_URL=

# Canonical site URL for JSON-LD / SEO
# NEXT_PUBLIC_SITE_URL=https://zerobug.ro

# Optional: protect weekly sitemap cron (Vercel sets Authorization: Bearer …)
# CRON_SECRET=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_SESSION_SECRET=change-this-long-random-secret

# Stripe (subscriptions + webhook)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (invoice emails + lead notifications)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=ZeroBug <contact@zerobug.ro>
LEADS_INBOX_EMAIL=contact@zerobug.ro
